@model WebApplication1.customer1

@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Customer - ID: @Html.DisplayFor(model => model.customer_id)</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>First Name: </dt>
        <dd>@Html.DisplayFor(model => model.first_name)</dd>

        <dt>Last Name:</dt>
        <dd>@Html.DisplayFor(model => model.last_name)</dd>

        <dt>Phone</dt>
        <dd>@Html.DisplayFor(model => model.phone)</dd>

        <dt>Email</dt>
        <dd>@Html.DisplayFor(model => model.email)</dd>

        <dt>Street</dt>
        <dd>@Html.DisplayFor(model => model.street)</dd>

        <dt>City</dt>
        <dd>@Html.DisplayFor(model => model.city)</dd>

        <dt>State</dt>
        <dd>@Html.DisplayFor(model => model.state)</dd>

        <dt>Zip Code</dt>
        <dd>@Html.DisplayFor(model => model.zip_code)</dd>

        <dt>FullName</dt>
        <dd>@Html.DisplayFor(model => model.full_name)</dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-default" /> |
            @Html.ActionLink("Back to List", "Read", "Customer")
        </div>
    }
</div>

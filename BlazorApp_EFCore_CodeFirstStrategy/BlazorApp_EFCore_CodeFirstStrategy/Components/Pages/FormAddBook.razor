@page "/formAddBook"
@page "/formAddBook/{BookId:int}"
@page "/formAddBook/autors/{AutorId:int}"

@using BlazorApp_EFCore_CodeFirstStrategy.Models
@using BlazorApp_EFCore_CodeFirstStrategy.Data

<h3>FormAddBook</h3>

@if(AutorId != null)
{
    <EditForm Model="@_newBook">
        <div>
            <label>Title:</label>
            <InputText @bind-value="_newBook.Title" />
        </div>

        <div>
            <label>Year:</label>
            <InputNumber @bind-value="_newBook.Year" />
        </div>

        <div>
            <label>NumberPages:</label>
            <InputNumber @bind-value="_newBook.NumberPages" />
        </div>
    </EditForm>
    <br />
    <button @onclick="AddBook">Add new book</button>
    <br />
}
else @if (_autors != null && BookId == null)
{
    <EditForm Model="@_newBook"> 

        <div>
            <label>Title:</label>
            <InputText @bind-value="_newBook.Title" />
        </div>

        <div>
            <label>Year:</label>
            <InputNumber  @bind-value="_newBook.Year" />
        </div>

        <div>
            <label>NumberPages:</label>
            <InputNumber  @bind-value="_newBook.NumberPages" />
        </div>

        <div>
            <label>Autor:</label>
                <InputText @bind-value="_searchTerm" @onkeyup="ApplyFilterOnDropdown" />
            <InputSelect @bind-value="_autorName" >
                <option> -- Select an autor -- </option>
                
                @foreach (var autor in _autors)
                {
                    <option value="@autor.FullName">@autor.FullName</option>
                }
            </InputSelect>
        </div>

        </EditForm>

        <br />
        <button @onclick="AddBook">Add new book</button>
        <br />
}else if(BookId != null)
{
    <EditForm Model="@_newBook">

        <div>
            <label>Id:</label>
            <InputNumber @bind-value="_newBook.Id" readonly="true"/>
        </div>

        <div>
            <label>Title:</label>
            <InputText @bind-value="_newBook.Title" />
        </div>

        <div>
            <label>Year:</label>
            <InputNumber @bind-value="_newBook.Year" />
        </div>

        <div>
            <label>NumberPages:</label>
            <InputNumber @bind-value="_newBook.NumberPages" />
        </div>

        <div>
            <label>Autor:</label>
            <InputSelect @bind-value="_autorName">
                <option> @_autorBook.FullName </option>
                @foreach (var autor in _autors)
                {
                    <option value="@autor.FullName">@autor.FullName</option>
                }
            </InputSelect>
        </div>
    </EditForm>
        <br />
        <button @onclick="UpdateBook">Update book</button>
        <br />
} 

@code {
    [Inject]
    private AppDbContext _dbContext { get; set; }

    [Inject]
    private NavigationManager _navigation { get; set; }

    [Inject]
    private AutorService _autorService { get; set; }

    [Inject]
    private BookService _bookService { get; set; }

    [Parameter]
    public int? BookId { get; set; }

    [Parameter]
    public int? AutorId { get; set; }

    private Book? _newBook { get; set; } = new(); 
    private Autor? _autorBook { get; set; } = new(); 
    private string? _autorName { get; set; }
    private List<Autor> _autors = new(); 
    private string? _searchTerm { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _autors = await _autorService.GetAutors();

        if (BookId != null)
        {
            _newBook = await _bookService.GetBookByIdAsync(BookId.Value);
            _autorBook = await _autorService.GetAutorByID(_newBook.AutorId.Value);
            _autorName = _autorBook.FullName;
        }
    }

    private async Task AddBook()
    {
        if (AutorId != null)
        {
            _newBook.AutorId = AutorId; 
        }

        if(_autorName != null)
        {
            //var autor = _autorService.GetAutorByName(_autorName); 
            var autor = await _autorService.GetAutorByNameAsync(_autorName); 

            if (autor != null)
            {
                _newBook.AutorId = autor.Id; 
            }
        }

        if (_newBook != null)
        {
            _dbContext.Books.Add(_newBook);
             _dbContext.SaveChanges(); 
        }

        await Task.Delay(2000);
        _navigation.NavigateTo("/books");
    }

    private async Task UpdateBook()
    {
        if (_autorName != _autorBook.FullName)
        {
            var newAutor = _autorService.GetAutorByName(_autorName);
            _newBook.AutorId = newAutor.Id;
        }

        await _bookService.UpdateBook();

        await Task.Delay(2000);
        _navigation.NavigateTo("/books"); 
    }

    private async Task ApplyFilterOnDropdown(KeyboardEventArgs keyPressed)
    {
        if(keyPressed.Key == "Enter")
        {
            if(_searchTerm != null)
            {
                _autors = await _autorService.GetAutorsFiltered(_searchTerm);
                await InvokeAsync(StateHasChanged);
            } 
            else
            {
                _autors = await _autorService.GetAutors();
                await InvokeAsync(StateHasChanged);
            }
        }
    }
}

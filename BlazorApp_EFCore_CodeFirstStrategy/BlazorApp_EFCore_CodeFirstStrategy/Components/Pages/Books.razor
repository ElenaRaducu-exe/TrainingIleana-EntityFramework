@page "/books"

@using BlazorApp_EFCore_CodeFirstStrategy.Data
@using BlazorApp_EFCore_CodeFirstStrategy.Models

<h3>Books</h3>

<table class="table">
    <thead>
        <tr class="tr-row">
            <th class="th-column">ID</th>
            <th class="th-column">Title</th>
            <th class="th-column">Year</th>
            <th class="th-column">NumberPages</th>
            <th class="th-column">Autor</th>
            <th class="th-column">Delete Book</th>
            <th class="th-column">Update Book</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in _booksDTO)
        {
            <tr class="tr-row">
                <th class="th-column">@book.Id</th>
                <th class ="th-column">@book.Title</th>
                <th class="th-column">@book.Year</th>
                <th class="th-column">@book.NumberPages</th>
                <th class="th-column">@book.AutorName</th>
                <th class="th-column">
                    <button @onclick="() => DeleteBook(book)"> DELETE </button>
                </th>
                <th class="th-column">
                    <button @onclick="() => NavigateToFormUpdateBook(book)"> Update </button>
                </th>
            </tr>
        }
    </tbody>
</table>

<button @onclick="NavigateToForm">Add Book</button>

@code {
        [Inject]
        private BookService _bookService { get; set; }

        [Inject]
        private AutorService _autorService { get; set; }

        [Inject]
        private NavigationManager _navigation { get; set; }

    private List<BookDTO> _booksDTO = new(); 

    protected override async Task OnInitializedAsync()
    {
        _booksDTO = await _bookService.GetBookDTOs();
    }

    private void NavigateToForm()
    {
        _navigation.NavigateTo("/formAddBook"); 
    }

    private async Task DeleteBook(BookDTO bookSelected)
    {
        await _bookService.RemoveBook(bookSelected.Id);
        _booksDTO.Remove(bookSelected);
    }

    private async Task NavigateToFormUpdateBook(BookDTO bookSelected)
    {
        _navigation.NavigateTo($"/formAddBook/{bookSelected.Id}");
    }
}

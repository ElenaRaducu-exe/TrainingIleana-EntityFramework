@page "/autors"

@using BlazorApp_EFCore_CodeFirstStrategy.Models
@using BlazorApp_EFCore_CodeFirstStrategy.Data

<h3>Autors</h3>

<table class="table">
    <thead>
        <tr class="tr-row">
            <th class="th-column">ID</th>
            <th class="th-column">FullName</th>
            <th class="th-column">Number Books</th>
            <th class="th-column">Book Names</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var autor in _autorsDTO)
        {
            <tr class="tr-row">
                <th class="th-column">@autor.AuthorId</th>
                <th class="th-column">@autor.AuthorName</th>
                <th class="th-column">@autor.NumberBooks</th>
                    @if(autor.BookNames.Count > 0)
                    {
                    <th class="th-column">@string.Join(", ", autor.BookNames)</th>
                    }else
                    {
                    <th class="th-column">Nu exista carti</th>
                    }
            </tr>
        }
    </tbody>
</table>

<br />
<br />
<br />

<button @onclick="NavigateToForm">Add Autor</button>

@code {
    [Inject]
    private NavigationManager _navigation { get; set; }

    [Inject]
    private AutorService _autorService { get; set; }

    //private List<Autor> _autors = new(); 
    private List<AuthorDTO> _autorsDTO = new(); 

    protected override async Task OnInitializedAsync()
    {
        //_autors = await _autorService.GetAutors(); 
        _autorsDTO = await _autorService.GetAuthorDTOs(); 
    }

    private void NavigateToForm()
    {
        _navigation.NavigateTo("/formAddAutor"); 
    }
}

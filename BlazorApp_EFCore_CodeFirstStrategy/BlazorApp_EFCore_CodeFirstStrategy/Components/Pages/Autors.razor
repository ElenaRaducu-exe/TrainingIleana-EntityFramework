@page "/autors"

@using BlazorApp_EFCore_CodeFirstStrategy.Models
@using BlazorApp_EFCore_CodeFirstStrategy.Data

<h3>Autors</h3>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>FullName</th>
            <th>Number Books</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var autor in _autorsDTO)
        {
            <tr>
                <th>@autor.AuthorId</th>
                <th>@autor.AuthorName</th>
                <th>@autor.NumberBooks</th>
            </tr>
        }
    </tbody>
</table>

<br />
<br />
<br />

<button @onclick="NavigateToForm">Add Autor</button>

@code {
    [Inject]
    private NavigationManager _navigation { get; set; }

    [Inject]
    private AutorService _autorService { get; set; }

    //private List<Autor> _autors = new(); 
    private List<AuthorDTO> _autorsDTO = new(); 

    protected override async Task OnInitializedAsync()
    {
        //_autors = await _autorService.GetAutors(); 
        _autorsDTO = await _autorService.GetAuthorDTOs(); 
    }

    private void NavigateToForm()
    {
        _navigation.NavigateTo("/formAddAutor"); 
    }
}
